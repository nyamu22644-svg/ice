# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ==============================================================================
# SUPABASE POSTGRESQL & STORAGE CONFIGURATION
# When configured, ICE connects directly to managed Supabase PostgreSQL with RLS.
# When omitted, ICE operates in self-contained synthetic demonstration mode.
# ==============================================================================

# NEXT_PUBLIC_SUPABASE_URL: Browser-safe Supabase project endpoint
NEXT_PUBLIC_SUPABASE_URL="https://your-project-id.supabase.co"

# MODERN SUPABASE KEYS (Recommended by Supabase):
# ------------------------------------------------------------------------------
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY: Browser-safe public API key (format: sbp_...)
# Used by frontend client and public authentication flows.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sbp_your_publishable_key_here"

# SUPABASE_SECRET_KEY: STRICTLY SERVER-ONLY secret key (format: sbs_...).
# NEVER expose this key to browser bundles or client-side code (no NEXT_PUBLIC_ prefix).
# Configure this in your deployment secrets (AI Studio Secrets / Cloud Run / .env.local).
# Used for privileged backend database operations, admin storage, and vision tasks.
SUPABASE_SECRET_KEY="sbs_your_secret_key_here"

# LEGACY SUPABASE KEYS (Backward-compatible fallback):
# ------------------------------------------------------------------------------
# If your project still uses legacy JWT-based keys, ICE supports them automatically:
# NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
# SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# DATABASE_URL: OPTIONAL. Direct PostgreSQL connection string.
# NOT REQUIRED for the ICE application to connect, query, or store data.
# Only needed if you run external command-line migrations (e.g. psql / supabase db push).
# DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-ID].supabase.co:5432/postgres"

# ==============================================================================
# INDEPENDENT PORTAL DOMAIN CONFIGURATIONS
# Controls entry points for the four distinct ICE operational experiences.
# In local development, port 3000 routes are used (/verify, /workspace, /developers, /platform).
# In production, reverse proxy or Cloudflare routes incoming hostnames.
# ==============================================================================

# NEXT_PUBLIC_VERIFY_DOMAIN: Customer-facing hosted verification flow
NEXT_PUBLIC_VERIFY_DOMAIN="verify.ice.example"

# NEXT_PUBLIC_WORKSPACE_DOMAIN: Business customer portal
NEXT_PUBLIC_WORKSPACE_DOMAIN="app.ice.example"

# NEXT_PUBLIC_DEVELOPERS_DOMAIN: Public developer docs and integration tools
NEXT_PUBLIC_DEVELOPERS_DOMAIN="developers.ice.example"

# NEXT_PUBLIC_PLATFORM_DOMAIN: Restricted ICE internal operations console
NEXT_PUBLIC_PLATFORM_DOMAIN="console.ice.example"

# ==============================================================================
# SUPABASE AUTH REDIRECT & CALLBACK URLS
# Configure these in Supabase Dashboard -> Authentication -> URL Configuration
# ==============================================================================
# Site URL: https://app.ice.example
# Additional Redirect URLs:
#   https://app.ice.example/auth/callback
#   https://developers.ice.example/auth/callback
#   https://console.ice.example/auth/callback
#   http://localhost:3000/auth/callback
# Email Confirmation URL: https://app.ice.example/auth/confirm
# Password Recovery URL: https://app.ice.example/auth/reset-password

